// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`snippet: compact-default-bullets format 1`] = `
====================================options=====================================
parsers: ["markdown"]
                                                      printWidth: 80 (default) |
=====================================input======================================
# Changelog

## 1.2.3

- Added a thing
- Fixed another thing

## 1.2.0

- Older change

=====================================output=====================================
# Changelog

## 1.2.3
- Added a thing
- Fixed another thing

## 1.2.0
- Older change

================================================================================
`;

